    <script>
        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') return;

            const buttonIdMap = {
                'cpu-benchmark-autocomplete_input': 'results:results-form:recommended-platforms:filter-platforms-button',
                'gpu-autocomplete_input': 'results:results-form:gpu-table:add-gpu-button'
            };

            const fullId = event.target.id;
            const lastPartOfId = fullId.split(':').pop();

            const buttonId = buttonIdMap[lastPartOfId];
            if (!buttonId) return;

            const button = document.getElementById(buttonId);
            if (button) button.click();
        });
    </script><?xml version="1.0" encoding="UTF-8"?>
